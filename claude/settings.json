      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"C:/Users/kruz7/.claude/hooks/memory-persistence/session-summarize.ps1\"",
            "timeout": 30
