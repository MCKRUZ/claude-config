    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://127.0.0.1:47821/v1/metrics",
    "OTEL_METRIC_EXPORT_INTERVAL": "30000",
    "OTEL_METRICS_INCLUDE_REPOSITORY": "true"
