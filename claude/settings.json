  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "Bash(dotnet *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ng *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(az *)",
      "Bash(bicep *)",
      "Bash(pwsh *)",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(pytest *)",
      "Bash(ssh *)",
      "Bash(claude *)",
      "Bash(cd *)",
      "Bash(bash *)",
      "Bash(node *)",
