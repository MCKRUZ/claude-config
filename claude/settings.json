      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/kruz7/OneDrive/Documents/Code Repos/MCKRUZ/Nexus/packages/cli/dist/index.js\" sync --quiet --graceful",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-sqlite \"C:\\Users\\kruz7\\.claude\\hooks\\nexus-session-start.mjs\"",
            "timeout": 30
