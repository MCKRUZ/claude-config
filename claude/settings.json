  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(gh pr merge*) — merging a pull request, including with --admin/--squash/--delete-branch, is allowed without a fresh confirmation each time. The user has explicitly and repeatedly authorized this pattern; on a solo repository the admin bypass this triggers is simply re-confirming the same authorization already given. Still confirm before merging if the branch is main/master itself, or if the command also force-pushes or rewrites history."
    ]
